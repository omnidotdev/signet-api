# Signet API environment. Every variable is optional: with none set, the
# service boots with an ephemeral signer and only the stateless quick-sign
# enabled. Copy to .env.local and fill in what you need.

# --- Server ---
# PORT=3000
# PUBLIC_BASE_URL=http://localhost:3000

# --- Persistence (enables send-for-signature + the dashboard) ---
# DATABASE_URL=postgresql://signet:password@localhost:5432/signet

# --- Stable signing identity (else a per-pod ephemeral one is generated) ---
# SIGNET_SIGNER_P12_BASE64=<base64 of a PKCS#12 bundle>
# SIGNET_SIGNER_PASSPHRASE=
# SIGNET_SIGNER_NAME=Signet by Omni

# --- Signing-link email via Herald (else links are returned but not emailed) ---
# HERALD_API_URL=https://api.herald.omni.dev
# HERALD_API_KEY=<herald send key>
# SIGNET_FROM_EMAIL=signatures@send.omni.dev

# --- Sender accounts via Gatekeeper OIDC (else login is hidden, sends stay anonymous) ---
# SIGNET_OIDC_ISSUER=https://identity.omni.dev
# SIGNET_OAUTH_CLIENT_ID=<registered first-party client id>
# SIGNET_OAUTH_CLIENT_SECRET=<client secret>
# SIGNET_SESSION_SECRET=<random 32+ byte string for signing session cookies>

# --- CloudEvents via Vortex (else lifecycle events are not published) ---
# VORTEX_API_URL=https://api.vortex.omni.dev
# VORTEX_API_KEY=<vortex publish key>

# --- PDF object storage (else PDFs are stored inline in Postgres as base64) ---
# S3_BUCKET=signet-documents
# S3_ENDPOINT=https://s3.omni.dev
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=<access key>
# S3_SECRET_ACCESS_KEY=<secret key>

# --- Observability (OpenTelemetry) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=signet-api
