{
  "name": "@omnidotdev/signet-api",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "Signet: provenance-first e-signature service",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "knip": "knip-bun",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "demo": "bun run src/scripts/signDemo.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@omnidotdev/providers": "github:omnidotdev/providers#5dc315939682ad5a01666c0e6df9336fa202982a",
    "@signpdf/placeholder-pdf-lib": "4.0.0",
    "@signpdf/signer-p12": "4.0.0",
    "@signpdf/signpdf": "4.0.0",
    "drizzle-orm": "0.45.1",
    "elysia": "1.4.22",
    "jose": "^6.2.17",
    "node-forge": "1.4.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "8.17.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@electric-sql/pglite": "0.3.11",
    "@types/bun": "^1.3.6",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "0.31.8",
    "husky": "^9.1.7",
    "knip": "^5.82.1",
    "typescript": "^5.7.3"
  }
}
