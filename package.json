    "drizzle-orm": "0.45.1",
    "elysia": "1.4.22",
    "node-forge": "1.4.3",
    "pdf-lib": "1.17.1",
    "pg": "8.17.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.11",
    "@types/bun": "^1.3.6",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "0.31.8"
  }
