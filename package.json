{
  "name": "@omnidotdev/signet-api",
  "version": "0.5.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "Signet: provenance-first e-signature service",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "knip": "knip-bun",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "demo": "bun run src/scripts/signDemo.ts",
    "signing:ca": "bun run src/scripts/generateSigningCa.ts",
    "release": "changeset publish",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@omnidotdev/providers": "github:omnidotdev/providers#b2406ef9155d6e3305a76343eafa68cb3f34fce3",
    "@pdf-lib/fontkit": "1.1.1",
    "@signpdf/placeholder-pdf-lib": "4.0.0",
    "@signpdf/signer-p12": "4.0.0",
    "@signpdf/signpdf": "4.0.0",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.32",
    "jose": "^6.2.17",
    "node-forge": "1.4.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@electric-sql/pglite": "0.5.16",
    "@types/bun": "^1.3.6",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "0.31.11",
    "husky": "^9.1.7",
    "knip": "^6.0.0",
    "typescript": "^5.7.3"
  }
}
